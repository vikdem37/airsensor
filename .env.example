# --- Data source ---
# can be set to browser for scraper testing, will likely be removed closer to finishing
SOURCE_MODE=api
# api mode: the JSON feed, and the location-name dictionary (names only; optional).
API_URL=https://api.alerts.in.ua/v3/alerts/active.json
LOCATIONS_URL=https://alerts.in.ua/assets/locations.json?v=5
# api mode: time limit for one request, in seconds.
REQUEST_TIMEOUT_S=10
# How often the source is read, in seconds.
POLL_INTERVAL_S=30
# Data is stale if it is older than this: api mode checks the CDN's Age header,
# browser mode the time since the page's own feed last succeeded.
STALE_AFTER_S=120

# --- browser mode only ---
SOURCE_URL=https://alerts.in.ua/
# The page's own feed requests, matched by this prefix. They are observed, never called.
FEED_URL_PREFIX=https://api.alerts.in.ua/v3/alerts/active
# Limit for a page load, for the map to appear and for the first feed response.
PAGE_TIMEOUT_S=30
# Scheduled page reload, so a long-open page does not keep growing in memory.
PAGE_RELOAD_EVERY_MIN=30
# ignored with api mode, and likely will get removed along with it

# --- Retries ---
# Exponential backoff limit
BACKOFF_MAX_S=60
# Re-open the source after every N consecutive failures (new HTTP client, or new Chromium).
BROWSER_RESTART_AFTER=5

# --- Internet probes (TCP connect, no root needed) ---
PROBE_TARGETS=8.8.8.8:53,1.1.1.1:53
PROBE_INTERVAL_S=30
PROBE_TIMEOUT_S=3

# --- Daily Telegram report  ---
# optional, leave either unset to turn off
BOT_TOKEN=
ADMIN_CHAT_ID=
# Europe/Kyiv time. The report covers the previous day.
REPORT_TIME=08:00

# --- Service ---
# DEBUG also logs every successful poll.
LOG_LEVEL=INFO
HTTP_PORT=8000
# Used by docker-compose.yml for the db service and for DATABASE_URL.
POSTGRES_PASSWORD=
